	/// "Held by rule" where held_by_rule is true: the breakeven gate kept the channel at current spend. Empty otherwise.
	column held_label
		dataType: string
		lineageTag: 51788da9-7b9e-5ede-8b8e-1baddec4af25
		summarizeBy: none
		sourceColumn: held_label

	partition Allocation = m
		mode: import
		source =
				let
				    Folder = if Text.EndsWith(ExportsPath, "\") then ExportsPath else ExportsPath & "\",
				    Source = Csv.Document(File.Contents(Folder & "recommendation_allocation.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"scenario", type text}, {"channel", type text}, {"current_spend", type number}, {"recommended_spend", type number}, {"delta", type number}, {"delta_pct", type number}, {"share_current", type number}, {"share_recommended", type number}, {"marginal_roas_current_median", type number}, {"marginal_roas_current_lo", type number}, {"marginal_roas_current_hi", type number}, {"marginal_roas_recommended_median", type number}, {"marginal_roas_recommended_lo", type number}, {"marginal_roas_recommended_hi", type number}, {"contribution_current_median", type number}, {"contribution_recommended_median", type number}, {"contribution_recommended_lo", type number}, {"contribution_recommended_hi", type number}, {"per_draw_share_median", type number}, {"held_by_rule", type logical}}, "en-US"),
				    Labelled = Table.AddColumn(Typed, "held_label", each if [held_by_rule] then "Held by rule" else "", type text)
				in
				    Labelled
