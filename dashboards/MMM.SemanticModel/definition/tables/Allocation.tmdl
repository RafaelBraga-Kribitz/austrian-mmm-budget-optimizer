		lineageTag: 4f281479-baed-5d32-9e8a-16830e5b373a
		summarizeBy: none
		sourceColumn: recommended_spend

	column delta
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: e4e825c5-2744-5fff-865d-4cd9b5ad7fd2
		summarizeBy: none
		sourceColumn: delta

	column delta_pct
		dataType: double
		isHidden
		formatString: 0.0
		lineageTag: cb8b4979-3608-573a-8ee6-382962ebd436
		summarizeBy: none
		sourceColumn: delta_pct

	column share_current
		dataType: double
		isHidden
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e9032059-a003-5871-bd45-f54da523fa16
		summarizeBy: none
		sourceColumn: share_current

	column share_recommended
		dataType: double
		isHidden
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9f2217a6-6ac3-5126-a075-5423d00d378c
		summarizeBy: none
		sourceColumn: share_recommended

	column marginal_roas_current_median
		dataType: double
		isHidden
		formatString: 0.00
		lineageTag: 5e790e5e-ffde-57db-b9b2-b7a7e0853b12
		summarizeBy: none
		sourceColumn: marginal_roas_current_median

	column marginal_roas_current_lo
		dataType: double
		isHidden
		formatString: 0.00
		lineageTag: 1caa3f4f-34ed-505c-afc9-1c4feece9ec5
		summarizeBy: none
		sourceColumn: marginal_roas_current_lo

	column marginal_roas_current_hi
