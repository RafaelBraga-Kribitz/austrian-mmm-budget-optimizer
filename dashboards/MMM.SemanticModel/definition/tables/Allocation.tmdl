		lineageTag: 1e5cfdc1-eadb-5b7f-9381-3b4a30b489d5
		summarizeBy: none
		sourceColumn: marginal_roas_recommended_median

	column marginal_roas_recommended_lo
		dataType: double
		isHidden
		formatString: 0.00
		lineageTag: 17b1da4c-83e3-5f25-ac97-cdca448e6a5d
		summarizeBy: none
		sourceColumn: marginal_roas_recommended_lo

	column marginal_roas_recommended_hi
		dataType: double
