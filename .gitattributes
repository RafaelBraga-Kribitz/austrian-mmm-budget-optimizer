# AMBO — .gitattributes
#
# LF is pinned here rather than left to local git config (D-22): local core.autocrlf
# does not travel with the repository and would make line-ending reproducibility depend
# on each reviewer's own setup. SIM-070's byte-identical CSV gate in Phase 2 depends on
# a deterministic, committed line-ending history from the first commit that adds a
# tracked text file.

# Catch-all: normalize everything git considers text to LF on checkin/checkout.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders over the catch-all).
*.md      text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.csv     text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.txt     text eol=lf
*.ipynb   text eol=lf
Makefile        text eol=lf
LICENSE         text eol=lf
.env.example    text eol=lf

# Binary types: never diff, never normalize line endings.
*.parquet  binary
*.png      binary
*.jpg      binary
*.pbix     binary
*.nc       binary
*.duckdb   binary
*.xlsx     binary
*.pdf      binary

# Keep generated / binary artifacts out of review diffs.
uv.lock     -diff
*.parquet   -diff
